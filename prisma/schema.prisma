generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                       String                     @id @default(cuid())
  name                     String
  code                     String                     @unique
  country                  String?
  city                     String?
  timezone                 String                     @default("Asia/Riyadh")
  logoUrl                  String?
  subscriptionPlan         String                     @default("trial")
  isActive                 Boolean                    @default(true)
  dataImportEnabled        Boolean                    @default(false)
  currency                 String                     @default("SAR")
  language                 String                     @default("EN-AR")
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  deletedAt                DateTime?
  assets                   Asset[]
  assetActionRequests      AssetActionRequest[]
  assetAssignmentHistory   AssetAssignmentHistory[]
  assetTransferRequests    AssetTransferRequest[]
  employees                Employee[]
  employeeTransferRequests EmployeeTransferRequest[]
  operations               Operation[]
  operationCorrections     OperationCorrection[]
  projects                 Project[]
  projectFuelPriceHistory  ProjectFuelPriceHistory[]
  roles                    Role[]
  stations                 Station[]
  stationAssignmentHistory StationAssignmentHistory[]
  stationStockMovements    StationStockMovement[]
  stationTransferRequests  StationTransferRequest[]
  stationActionRequests    StationActionRequest[]
  users                    User[]
  importBatches            ImportBatch[]
}

enum ImportType {
  PROJECTS
  EMPLOYEES
  ASSETS
  STATIONS
  OPENING_VALUES
  HISTORICAL_OPERATIONS
}

enum ImportBatchStatus {
  UPLOADED
  VALIDATING
  VALIDATED
  READY_TO_IMPORT
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportExecutionMode {
  ALL_OR_NOTHING
}

model ImportBatch {
  id                  String              @id @default(cuid())
  companyId           String
  importType          ImportType
  schemaVersion       Int
  validationVersion   Int                 @default(1)
  templateLanguage    String?
  originalFileName    String
  fileSizeBytes       Int
  fileHash            String
  status              ImportBatchStatus   @default(UPLOADED)
  executionMode       ImportExecutionMode @default(ALL_OR_NOTHING)
  totalRows           Int                 @default(0)
  validRows           Int                 @default(0)
  invalidRows         Int                 @default(0)
  warningRows         Int                 @default(0)
  importedRows        Int                 @default(0)
  failedRows          Int                 @default(0)
  uploadedByUserId    String
  confirmedByUserId   String?
  uploadedAt          DateTime            @default(now())
  validatedAt         DateTime?
  confirmedAt         DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  failedAt            DateTime?
  failureCode         String?
  failureMessage      String?
  company             Company             @relation(fields: [companyId], references: [id])
  uploadedBy          User                @relation("ImportBatchUploadedBy", fields: [uploadedByUserId], references: [id])
  confirmedBy         User?               @relation("ImportBatchConfirmedBy", fields: [confirmedByUserId], references: [id])
  rows                 ImportRow[]

  @@index([companyId])
  @@index([importType])
  @@index([status])
  @@index([uploadedByUserId])
  @@index([uploadedAt])
}

model ImportRow {
  id             String      @id @default(cuid())
  batchId        String
  rowNumber      Int
  sourceData     Json
  normalizedData Json?
  computedData   Json?
  errors         Json?
  warnings       Json?
  isValid        Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  batch          ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, rowNumber])
  @@index([batchId])
  @@index([isValid])
}

model Project {
  id                           String                     @id @default(cuid())
  companyId                    String
  code                         String
  name                         String
  location                     String?
  description                  String?
  isActive                     Boolean                    @default(true)
  createdById                  String?
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
  deletedAt                    DateTime?
  projectManagerId             String?
  currentFuelPrice             Float                      @default(0)
  currentBaseFuelPrice         Float?
  currentTransportCostPerLiter Float?
  currentVatRate               Float?
  currentGrossFuelPrice        Float?
  fuelPriceCurrency            String                     @default("SAR")
  fuelPriceEffectiveFrom       DateTime?
  assets                       Asset[]
  assetActionRequests          AssetActionRequest[]
  assetAssignmentHistoryFrom   AssetAssignmentHistory[]   @relation("AssetAssignmentFromProject")
  assetAssignmentHistoryTo     AssetAssignmentHistory[]   @relation("AssetAssignmentToProject")
  assetTransferApprovals       AssetTransferApproval[]    @relation("AssetTransferApprovalProject")
  assetTransferRequestsFrom    AssetTransferRequest[]     @relation("AssetTransferFromProject")
  assetTransferRequestsTo      AssetTransferRequest[]     @relation("AssetTransferToProject")
  employees                    Employee[]
  employeeTransferApprovals    EmployeeTransferApproval[] @relation("EmployeeTransferApprovalProject")
  employeeTransferRequestsFrom EmployeeTransferRequest[]  @relation("EmployeeTransferFromProject")
  employeeTransferRequestsTo   EmployeeTransferRequest[]  @relation("EmployeeTransferToProject")
  operationApprovals           OperationApproval[]        @relation("OperationApprovalProject")
  company                      Company                    @relation(fields: [companyId], references: [id])
  createdBy                    User?                      @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  projectManager               User?                      @relation("ProjectManager", fields: [projectManagerId], references: [id])
  fuelPriceHistory             ProjectFuelPriceHistory[]
  stations                     Station[]
  stationAssignmentHistoryFrom StationAssignmentHistory[] @relation("StationAssignmentFromProject")
  stationAssignmentHistoryTo   StationAssignmentHistory[] @relation("StationAssignmentToProject")
  stationTransferApprovals     StationTransferApproval[]  @relation("StationTransferApprovalProject")
  stationTransferRequestsFrom  StationTransferRequest[]   @relation("StationTransferFromProject")
  stationTransferRequestsTo    StationTransferRequest[]   @relation("StationTransferToProject")
  stationActionRequests        StationActionRequest[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([projectManagerId])
}

model Role {
  id           String           @id @default(cuid())
  companyId    String?
  name         String
  description  String?
  isSystemRole Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  company      Company?         @relation(fields: [companyId], references: [id])
  permissions  RolePermission[]
  users        User[]

  @@unique([companyId, name])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model User {
  id                            String                     @id @default(cuid())
  companyId                     String
  roleId                        String
  fullName                      String
  email                         String?                    @unique
  phone                         String?
  passwordHash                  String
  isActive                      Boolean                    @default(true)
  mustChangePassword            Boolean                    @default(false)
  preferredLanguage             String                     @default("en")
  lastLoginAt                   DateTime?
  createdById                   String?
  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt
  deletedAt                     DateTime?
  employeeId                    String?
  username                      String?                    @unique
  createdAssets                 Asset[]                    @relation("AssetCreatedBy")
  assetAssignmentHistory        AssetAssignmentHistory[]   @relation("AssetAssignmentAssignedBy")
  assetOdometerResets           AssetOdometerReset[]
  requestedAssetActions         AssetActionRequest[]       @relation("AssetActionRequestedBy")
  reviewedAssetActions          AssetActionRequest[]       @relation("AssetActionReviewedBy")
  assetTransferApprovals        AssetTransferApproval[]    @relation("AssetTransferApprover")
  requestedAssetTransfers       AssetTransferRequest[]     @relation("AssetTransferRequestedBy")
  createdEmployees              Employee[]                 @relation("EmployeeCreatedBy")
  linkedEmployee                Employee?                  @relation("EmployeeLinkedUser")
  employeeTransferApprovals     EmployeeTransferApproval[] @relation("EmployeeTransferApprover")
  requestedEmployeeTransfers    EmployeeTransferRequest[]  @relation("EmployeeTransferRequestedBy")
  requestedOperations           Operation[]                @relation("OperationRequestedBy")
  operationApprovals            OperationApproval[]        @relation("OperationApprover")
  requestedOperationCorrections OperationCorrection[]      @relation("OperationCorrectionRequestedBy")
  reviewedOperationCorrections  OperationCorrection[]      @relation("OperationCorrectionReviewedBy")
  createdProjects               Project[]                  @relation("ProjectCreatedBy")
  managedProjects               Project[]                  @relation("ProjectManager")
  projectFuelPriceHistory       ProjectFuelPriceHistory[]
  refreshTokens                 RefreshToken[]
  createdStations               Station[]                  @relation("StationCreatedBy")
  stationAssignmentHistory      StationAssignmentHistory[] @relation("StationAssignmentAssignedBy")
  stationCounterResets          StationCounterReset[]
  stationStockMovements         StationStockMovement[]
  stationTransferApprovals      StationTransferApproval[]  @relation("StationTransferApprover")
  requestedStationTransfers     StationTransferRequest[]   @relation("StationTransferRequestedBy")
  requestedStationActions       StationActionRequest[]     @relation("StationActionRequestedBy")
  reviewedStationActions        StationActionRequest[]     @relation("StationActionReviewedBy")
  uploadedImportBatches         ImportBatch[]               @relation("ImportBatchUploadedBy")
  confirmedImportBatches        ImportBatch[]               @relation("ImportBatchConfirmedBy")
  company                       Company                    @relation(fields: [companyId], references: [id])
  createdBy                     User?                      @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers                  User[]                     @relation("UserCreatedBy")
  role                          Role                       @relation(fields: [roleId], references: [id])

  @@unique([companyId, employeeId])
  @@index([companyId])
  @@index([roleId])
  @@index([employeeId])
  @@index([username])
}

model Employee {
  id               String                    @id @default(cuid())
  companyId        String
  employeeId       String
  name             String
  phone            String?
  email            String?
  jobTitle         String                    @default("Operator")
  status           EmployeeStatus            @default(ON_DUTY)
  projectId        String?
  linkedUserId     String?                   @unique
  createdById      String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  deletedAt        DateTime?
  company          Company                   @relation(fields: [companyId], references: [id])
  createdBy        User?                     @relation("EmployeeCreatedBy", fields: [createdById], references: [id])
  linkedUser       User?                     @relation("EmployeeLinkedUser", fields: [linkedUserId], references: [id])
  project          Project?                  @relation(fields: [projectId], references: [id])
  transferRequests EmployeeTransferRequest[]

  @@unique([companyId, employeeId])
  @@index([companyId])
  @@index([projectId])
  @@index([status])
}

model EmployeeTransferRequest {
  id                     String                     @id @default(cuid())
  companyId              String
  employeeId             String
  fromProjectId          String
  toProjectId            String
  requestedByUserId      String
  transferBatchId        String?
  employeeCodeAtTransfer String?
  employeeNameAtTransfer String?
  status                 EmployeeTransferStatus     @default(PENDING)
  reason                 String?
  rejectionReason        String?
  approvedAt             DateTime?
  rejectedAt             DateTime?
  cancelledAt            DateTime?
  appliedAt              DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  effectiveDate          DateTime?
  approvals              EmployeeTransferApproval[]
  company                Company                    @relation(fields: [companyId], references: [id])
  employee               Employee                   @relation(fields: [employeeId], references: [id])
  fromProject            Project                    @relation("EmployeeTransferFromProject", fields: [fromProjectId], references: [id])
  requestedBy            User                       @relation("EmployeeTransferRequestedBy", fields: [requestedByUserId], references: [id])
  toProject              Project                    @relation("EmployeeTransferToProject", fields: [toProjectId], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@index([fromProjectId])
  @@index([toProjectId])
  @@index([requestedByUserId])
  @@index([transferBatchId])
  @@index([employeeCodeAtTransfer])
  @@index([status])
}

model EmployeeTransferApproval {
  id                String                         @id @default(cuid())
  transferRequestId String
  approverUserId    String
  projectId         String
  approvalStage     String
  status            EmployeeTransferApprovalStatus @default(PENDING)
  note              String?
  reviewedAt        DateTime?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  approver          User                           @relation("EmployeeTransferApprover", fields: [approverUserId], references: [id])
  project           Project                        @relation("EmployeeTransferApprovalProject", fields: [projectId], references: [id])
  transferRequest   EmployeeTransferRequest        @relation(fields: [transferRequestId], references: [id])

  @@unique([transferRequestId, approverUserId, projectId])
  @@index([transferRequestId])
  @@index([approverUserId])
  @@index([projectId])
  @@index([status])
}

model Asset {
  id                      String                   @id @default(cuid())
  companyId               String
  assetId                 String
  type                    String
  category                String?
  fuelTankCapacity        Float?
  currentOdometer         Float                    @default(0)
  status                  AssetStatus              @default(ACTIVE)
  projectId               String?
  createdById             String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  currentLifetimeOdometer Float                    @default(0)
  currentMeterCycle       Int                      @default(1)
  company                 Company                  @relation(fields: [companyId], references: [id])
  createdBy               User?                    @relation("AssetCreatedBy", fields: [createdById], references: [id])
  project                 Project?                 @relation(fields: [projectId], references: [id])
  assignmentHistory       AssetAssignmentHistory[]
  actionRequests          AssetActionRequest[]
  odometerResetHistory    AssetOdometerReset[]
  transferRequests        AssetTransferRequest[]
  operations              Operation[]

  @@unique([companyId, assetId])
  @@index([companyId])
  @@index([projectId])
  @@index([status])
}

model AssetOdometerReset {
  id              String   @id @default(cuid())
  assetId         String
  companyId       String
  oldOdometer     Float
  newOdometer     Float
  reason          String
  effectiveAt     DateTime @default(now())
  createdByUserId String?
  createdAt       DateTime @default(now())
  lifetimeAtReset Float    @default(0)
  newMeterCycle   Int      @default(1)
  oldMeterCycle   Int      @default(1)
  asset           Asset    @relation(fields: [assetId], references: [id])
  createdBy       User?    @relation(fields: [createdByUserId], references: [id])

  @@index([assetId])
  @@index([companyId])
  @@index([createdByUserId])
}

model AssetTransferRequest {
  id                String                   @id @default(cuid())
  companyId         String
  assetId           String
  fromProjectId     String
  toProjectId       String
  requestedByUserId String
  status            EmployeeTransferStatus   @default(PENDING)
  reason            String?
  rejectionReason   String?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  cancelledAt       DateTime?
  appliedAt         DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  effectiveDate     DateTime?
  transferBatchId   String?
  assignmentHistory AssetAssignmentHistory[]
  approvals         AssetTransferApproval[]
  asset             Asset                    @relation(fields: [assetId], references: [id])
  company           Company                  @relation(fields: [companyId], references: [id])
  fromProject       Project                  @relation("AssetTransferFromProject", fields: [fromProjectId], references: [id])
  requestedBy       User                     @relation("AssetTransferRequestedBy", fields: [requestedByUserId], references: [id])
  toProject         Project                  @relation("AssetTransferToProject", fields: [toProjectId], references: [id])

  @@index([companyId])
  @@index([assetId])
  @@index([fromProjectId])
  @@index([toProjectId])
  @@index([requestedByUserId])
  @@index([transferBatchId])
  @@index([status])
}

model AssetTransferApproval {
  id                String                         @id @default(cuid())
  transferRequestId String
  approverUserId    String
  projectId         String
  approvalStage     String
  status            EmployeeTransferApprovalStatus @default(PENDING)
  note              String?
  reviewedAt        DateTime?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  approver          User                           @relation("AssetTransferApprover", fields: [approverUserId], references: [id])
  project           Project                        @relation("AssetTransferApprovalProject", fields: [projectId], references: [id])
  transferRequest   AssetTransferRequest           @relation(fields: [transferRequestId], references: [id])

  @@unique([transferRequestId, approverUserId, projectId])
  @@index([transferRequestId])
  @@index([approverUserId])
  @@index([projectId])
  @@index([status])
}

model AssetActionRequest {
  id                String                   @id @default(cuid())
  companyId         String
  assetId           String
  projectId         String?
  requestedByUserId String
  actionType        AssetActionType
  status            AssetActionRequestStatus @default(PENDING)
  reason            String
  requestedOdometer Float?
  effectiveAt       DateTime?
  reviewedByUserId  String?
  reviewNote        String?
  reviewedAt        DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  appliedAt         DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  company           Company                  @relation(fields: [companyId], references: [id])
  asset             Asset                    @relation(fields: [assetId], references: [id])
  project           Project?                 @relation(fields: [projectId], references: [id])
  requestedBy       User                     @relation("AssetActionRequestedBy", fields: [requestedByUserId], references: [id])
  reviewedBy        User?                    @relation("AssetActionReviewedBy", fields: [reviewedByUserId], references: [id])

  @@index([companyId])
  @@index([assetId])
  @@index([projectId])
  @@index([requestedByUserId])
  @@index([reviewedByUserId])
  @@index([actionType])
  @@index([status])
  @@index([createdAt])
}

model AssetAssignmentHistory {
  id                String                @id @default(cuid())
  companyId         String
  assetId           String
  fromProjectId     String?
  toProjectId       String
  transferRequestId String?
  assignmentType    AssetAssignmentType
  reason            String?
  assignedAt        DateTime              @default(now())
  assignedByUserId  String?
  createdAt         DateTime              @default(now())
  asset             Asset                 @relation(fields: [assetId], references: [id])
  assignedBy        User?                 @relation("AssetAssignmentAssignedBy", fields: [assignedByUserId], references: [id])
  company           Company               @relation(fields: [companyId], references: [id])
  fromProject       Project?              @relation("AssetAssignmentFromProject", fields: [fromProjectId], references: [id])
  toProject         Project               @relation("AssetAssignmentToProject", fields: [toProjectId], references: [id])
  transferRequest   AssetTransferRequest? @relation(fields: [transferRequestId], references: [id])

  @@index([companyId])
  @@index([assetId])
  @@index([fromProjectId])
  @@index([toProjectId])
  @@index([transferRequestId])
  @@index([assignedByUserId])
  @@index([assignedAt])
}

model Station {
  id                     String                     @id @default(cuid())
  companyId              String
  stationId              String
  name                   String?
  type                   String?
  capacity               Float?
  openingBalance         Float                      @default(0)
  currentStock           Float                      @default(0)
  currentCounter         Float                      @default(0)
  status                 StationStatus              @default(ACTIVE)
  projectId              String?
  createdById            String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  deletedAt              DateTime?
  currentCounterCycle    Int                        @default(1)
  currentLifetimeCounter Float                      @default(0)
  destinationOperations  Operation[]                @relation("OperationDestinationStation")
  sourceOperations       Operation[]                @relation("OperationSourceStation")
  company                Company                    @relation(fields: [companyId], references: [id])
  createdBy              User?                      @relation("StationCreatedBy", fields: [createdById], references: [id])
  project                Project?                   @relation(fields: [projectId], references: [id])
  assignmentHistory      StationAssignmentHistory[]
  counterResetHistory    StationCounterReset[]
  stockMovements         StationStockMovement[]
  transferRequests       StationTransferRequest[]
  actionRequests         StationActionRequest[]

  @@unique([companyId, stationId])
  @@index([companyId])
  @@index([projectId])
  @@index([status])
}

model StationCounterReset {
  id              String   @id @default(cuid())
  stationId       String
  companyId       String
  oldCounter      Float
  newCounter      Float
  reason          String
  effectiveAt     DateTime @default(now())
  createdByUserId String?
  createdAt       DateTime @default(now())
  lifetimeAtReset Float    @default(0)
  newCounterCycle Int      @default(1)
  oldCounterCycle Int      @default(1)
  createdBy       User?    @relation(fields: [createdByUserId], references: [id])
  station         Station  @relation(fields: [stationId], references: [id])

  @@index([stationId])
  @@index([companyId])
  @@index([createdByUserId])
}

model StationStockMovement {
  id              String                   @id @default(cuid())
  stationId       String
  companyId       String
  movementType    StationStockMovementType
  quantity        Float
  balanceBefore   Float
  balanceAfter    Float
  referenceType   String?
  referenceId     String?
  reason          String?
  movementAt      DateTime                 @default(now())
  createdByUserId String?
  createdAt       DateTime                 @default(now())
  company         Company                  @relation(fields: [companyId], references: [id])
  createdBy       User?                    @relation(fields: [createdByUserId], references: [id])
  station         Station                  @relation(fields: [stationId], references: [id])

  @@index([stationId])
  @@index([companyId])
  @@index([movementType])
  @@index([movementAt])
  @@index([referenceType, referenceId])
}

model Operation {
  id                                String                   @id @default(cuid())
  companyId                         String
  operationNo                       String
  type                              OperationType
  status                            OperationStatus          @default(COMPLETED)
  sourceStationId                   String?
  destinationStationId              String?
  assetId                           String?
  quantity                          Float
  odometer                          Float?
  stationCounter                    Float?
  externalStationName               String?
  invoiceNumber                     String?
  notes                             String?
  attachments                       Json?
  requestedByUserId                 String
  fuelerEmployeeIdAtOperation       String?
  fuelerNameAtOperation             String?
  completedAt                       DateTime?
  approvedAt                        DateTime?
  rejectedAt                        DateTime?
  cancelledAt                       DateTime?
  createdAt                         DateTime                 @default(now())
  updatedAt                         DateTime                 @updatedAt
  fuelPriceHistoryId                String?
  pricePerLiterAtOperation          Float?
  totalCostAtOperation              Float?
  basePricePerLiterAtOperation      Float?
  transportCostPerLiterAtOperation  Float?
  vatRateAtOperation                Float?
  vatAmountPerLiterAtOperation      Float?
  grossPricePerLiterAtOperation     Float?
  grossTotalCostAtOperation         Float?
  assetMeterCycleNumber             Int?
  lifetimeCounter                   Float?
  lifetimeOdometer                  Float?
  stationCounterCycleNumber         Int?
  projectIdAtOperation              String?
  projectNameAtOperation            String?
  sourceProjectIdAtOperation        String?
  sourceProjectNameAtOperation      String?
  destinationProjectIdAtOperation   String?
  destinationProjectNameAtOperation String?
  asset                             Asset?                   @relation(fields: [assetId], references: [id])
  company                           Company                  @relation(fields: [companyId], references: [id])
  destinationStation                Station?                 @relation("OperationDestinationStation", fields: [destinationStationId], references: [id])
  fuelPriceHistory                  ProjectFuelPriceHistory? @relation(fields: [fuelPriceHistoryId], references: [id])
  requestedBy                       User                     @relation("OperationRequestedBy", fields: [requestedByUserId], references: [id])
  sourceStation                     Station?                 @relation("OperationSourceStation", fields: [sourceStationId], references: [id])
  approvals                         OperationApproval[]
  corrections                       OperationCorrection[]

  @@unique([companyId, operationNo])
  @@index([companyId])
  @@index([type])
  @@index([status])
  @@index([sourceStationId])
  @@index([destinationStationId])
  @@index([assetId])
  @@index([requestedByUserId])
  @@index([fuelerEmployeeIdAtOperation])
  @@index([fuelPriceHistoryId])
  @@index([projectIdAtOperation])
  @@index([sourceProjectIdAtOperation])
  @@index([destinationProjectIdAtOperation])
  @@index([createdAt])
  @@index([companyId, createdAt])
  @@index([companyId, status, createdAt])
}

model OperationApproval {
  id             String                  @id @default(cuid())
  operationId    String
  approverUserId String
  projectId      String
  approvalStage  String
  status         OperationApprovalStatus @default(PENDING)
  note           String?
  reviewedAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  approver       User                    @relation("OperationApprover", fields: [approverUserId], references: [id])
  operation      Operation               @relation(fields: [operationId], references: [id])
  project        Project                 @relation("OperationApprovalProject", fields: [projectId], references: [id])

  @@unique([operationId, approverUserId, projectId])
  @@index([operationId])
  @@index([approverUserId])
  @@index([projectId])
  @@index([status])
}

model OperationCorrection {
  id                String                    @id @default(cuid())
  companyId         String
  operationId       String
  fieldName         OperationCorrectionField
  oldValue          Json?
  newValue          Json?
  reason            String
  status            OperationCorrectionStatus @default(PENDING)
  requestedByUserId String
  reviewedByUserId  String?
  reviewNote        String?
  reviewedAt        DateTime?
  appliedAt         DateTime?
  rejectedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  company           Company                   @relation(fields: [companyId], references: [id])
  operation         Operation                 @relation(fields: [operationId], references: [id])
  requestedBy       User                      @relation("OperationCorrectionRequestedBy", fields: [requestedByUserId], references: [id])
  reviewedBy        User?                     @relation("OperationCorrectionReviewedBy", fields: [reviewedByUserId], references: [id])

  @@index([companyId])
  @@index([operationId])
  @@index([requestedByUserId])
  @@index([reviewedByUserId])
  @@index([fieldName])
  @@index([status])
  @@index([createdAt])
  @@index([companyId, status, createdAt])
  @@index([operationId, fieldName, status])
}

model ProjectFuelPriceHistory {
  id                 String      @id @default(cuid())
  projectId          String
  companyId          String
  country            String?
  currency           String
  basePricePerLiter  Float?
  transportCost      Float?
  pricePerLiter      Float
  vatRate            Float?
  vatAmountPerLiter  Float?
  grossPricePerLiter Float?
  effectiveFrom      DateTime
  reason             String?
  createdByUserId    String?
  createdAt          DateTime    @default(now())
  operations         Operation[]
  company            Company     @relation(fields: [companyId], references: [id])
  createdBy          User?       @relation(fields: [createdByUserId], references: [id])
  project            Project     @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([companyId])
  @@index([country])
  @@index([effectiveFrom])
}

model StationTransferRequest {
  id                String                     @id @default(cuid())
  companyId         String
  stationId         String
  fromProjectId     String
  toProjectId       String
  requestedByUserId String
  status            StationTransferStatus      @default(PENDING)
  reason            String?
  rejectionReason   String?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  cancelledAt       DateTime?
  appliedAt         DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  effectiveDate     DateTime?
  stockAtTransfer   Float                      @default(0)
  assignmentHistory StationAssignmentHistory[]
  approvals         StationTransferApproval[]
  company           Company                    @relation(fields: [companyId], references: [id])
  fromProject       Project                    @relation("StationTransferFromProject", fields: [fromProjectId], references: [id])
  requestedBy       User                       @relation("StationTransferRequestedBy", fields: [requestedByUserId], references: [id])
  station           Station                    @relation(fields: [stationId], references: [id])
  toProject         Project                    @relation("StationTransferToProject", fields: [toProjectId], references: [id])

  @@index([companyId])
  @@index([stationId])
  @@index([fromProjectId])
  @@index([toProjectId])
  @@index([requestedByUserId])
  @@index([status])
}

model StationTransferApproval {
  id                String                        @id @default(cuid())
  transferRequestId String
  approverUserId    String
  projectId         String
  approvalStage     String
  status            StationTransferApprovalStatus @default(PENDING)
  note              String?
  reviewedAt        DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  approver          User                          @relation("StationTransferApprover", fields: [approverUserId], references: [id])
  project           Project                       @relation("StationTransferApprovalProject", fields: [projectId], references: [id])
  transferRequest   StationTransferRequest        @relation(fields: [transferRequestId], references: [id])

  @@unique([transferRequestId, approverUserId, projectId])
  @@index([transferRequestId])
  @@index([approverUserId])
  @@index([projectId])
  @@index([status])
}

model StationActionRequest {
  id                   String                     @id @default(cuid())
  companyId            String
  stationId            String
  projectId            String?
  requestedByUserId    String
  actionType           StationActionType
  status               StationActionRequestStatus @default(PENDING)
  reason               String
  requestedActualStock Float?
  requestedCounter     Float?
  effectiveAt          DateTime?
  movementAt           DateTime?
  reviewedByUserId     String?
  reviewNote           String?
  reviewedAt           DateTime?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  appliedAt            DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  company              Company                    @relation(fields: [companyId], references: [id])
  station              Station                    @relation(fields: [stationId], references: [id])
  project              Project?                   @relation(fields: [projectId], references: [id])
  requestedBy          User                       @relation("StationActionRequestedBy", fields: [requestedByUserId], references: [id])
  reviewedBy           User?                      @relation("StationActionReviewedBy", fields: [reviewedByUserId], references: [id])

  @@index([companyId])
  @@index([stationId])
  @@index([projectId])
  @@index([requestedByUserId])
  @@index([reviewedByUserId])
  @@index([actionType])
  @@index([status])
  @@index([createdAt])
}

model StationAssignmentHistory {
  id                String                  @id @default(cuid())
  companyId         String
  stationId         String
  fromProjectId     String?
  toProjectId       String
  transferRequestId String?
  assignmentType    StationAssignmentType
  reason            String?
  assignedAt        DateTime                @default(now())
  assignedByUserId  String?
  createdAt         DateTime                @default(now())
  assignedBy        User?                   @relation("StationAssignmentAssignedBy", fields: [assignedByUserId], references: [id])
  company           Company                 @relation(fields: [companyId], references: [id])
  fromProject       Project?                @relation("StationAssignmentFromProject", fields: [fromProjectId], references: [id])
  station           Station                 @relation(fields: [stationId], references: [id])
  toProject         Project                 @relation("StationAssignmentToProject", fields: [toProjectId], references: [id])
  transferRequest   StationTransferRequest? @relation(fields: [transferRequestId], references: [id])

  @@index([companyId])
  @@index([stationId])
  @@index([fromProjectId])
  @@index([toProjectId])
  @@index([transferRequestId])
  @@index([assignedByUserId])
  @@index([assignedAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

